# ── Required ──────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udhaar

# ── Payment proof photo storage (Cloudinary) ─────────────────
# Proof screenshots are private: they are uploaded as "authenticated" assets
# and only ever handed out by GET /api/payments/[id]/proof, which first checks
# that the caller is on the loan. The API secret is what signs those requests,
# so treat it like a password.
#
# Without these set, uploading a proof fails with a clear "Cloudinary is not
# configured" error instead of silently storing giant base64 blobs in Postgres,
# and viewing an existing one returns a 503 that names these variables.
# Free tier: https://cloudinary.com/users/register/free
# Copy all three from Dashboard -> Product Environment Credentials (or
# Settings -> API Keys). The API secret is NOT your account password.
# Verify with `npm run check-deploy` - it makes one signed request and says
# whether the credentials actually work (401 = wrong secret, 404 = wrong
# cloud name) instead of leaving it to the first upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional - only if your account serves assets from a custom domain.
CLOUDINARY_DELIVERY_HOST=

# ── OTP delivery ─────────────────────────────────────────────
# "auto"  (default): real SMS when MSG91 is configured below; in development
#         it falls back to a dummy OTP and returns the code in the API
#         response; in production it refuses to serve OTP requests rather
#         than handing the code out.
# "dummy": always use the dummy OTP, in every environment. Anyone who can
#         reach /api/auth can then log in as any mobile number - handy for
#         testing, never for a public launch.
# "sms":   always use MSG91, and fail loudly if it isn't configured.
OTP_MODE=auto

# ── SMS delivery (MSG91) ─────────────────────────────────────
# Leave blank to keep using the dummy OTP. When filled in, real OTPs are sent
# and the code is never included in API responses.
# Sign up: https://msg91.com → create a DLT-approved Flow template with a
# variable named OTP, then paste its ID below.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=

# ── Security & limits ────────────────────────────────────────
# Most of the hardening needs no configuration; these are the knobs.
#
# Where the app may be embedded (the frame-ancestors part of the CSP).
#   'none'  (default) - nobody may frame the app. Safest.
#   'self'            - only the app itself.
#   'self' https://*.e2b.app - also allow these hosts to frame it.
# READ THIS ONE CAREFULLY: it is read when the app is BUILT, not when it starts.
# It is baked into the routes manifest, so setting it on a running server does
# nothing - set it where the build happens (a Docker build arg, the CI job, or
# `FRAME_ANCESTORS="..." npm run build` locally) and redeploy.
FRAME_ANCESTORS=

# The health endpoint is public on purpose (an uptime ping, the deploy
# verifier). Strangers get the verdicts and a plain "set"/"up to date"; the
# infrastructure detail - the database host, which integrations are configured,
# the error text behind a failure - is only returned to a caller who sends this
# token in an `x-health-token` header. Leave blank to hide it from everyone.
#   curl -s -H "x-health-token: $HEALTH_TOKEN" https://your-app/api/health
HEALTH_TOKEN=

# OTP sending is capped three ways, deliberately layered. The per-connection cap
# is in memory (10 requests per 10 minutes per caller, not configurable); these
# two are counted from the otps table, so they survive a restart and cannot be
# reset by one.
#
# How many OTPs one number may ask for in a day. Ten is generous for a human
# who mistypes; it is what stops a stranger using your app to send somebody a
# hundred SMS messages.
OTP_PER_MOBILE_DAILY_MAX=10
# A service-wide ceiling for how many OTPs may be sent in an hour. This is the
# backstop for the case the per-caller cap cannot see - a botnet rotating the
# X-Forwarded-For header - and it is also what bounds your SMS bill if
# something goes wrong. Raise it if you have many real users logging in at once.
OTP_GLOBAL_HOURLY_MAX=300

# ── Scheduled reminders (the free "clock") ───────────────────
# Anything long and random. The server refuses to run a reminder sweep without
# it, so this endpoint can never be used by strangers to spam your borrowers.
#   openssl rand -hex 32        (or any 40+ random characters)
# Local: put it here. Production: set it on the service, and add the same value
# as a GitHub Actions secret named CRON_SECRET so
# .github/workflows/reminders.yml can trigger the daily sweep.
CRON_SECRET=

# ── Real push notifications (Firebase Cloud Messaging) ───────
# Without this set, the app still works, but reminders/loan-added
# notifications only get recorded in the Activity feed - nothing is
# actually pushed to the borrower's phone.
#
# 1. Create a Firebase project: https://console.firebase.google.com
# 2. Project Settings → Service Accounts → Generate new private key
#    (downloads a JSON file)
# 3. Base64-encode it and paste the result below:
#      base64 -i service-account.json | tr -d '\n'
# 4. For Android: download google-services.json from the same Firebase
#    project and place it at android/app/google-services.json
#    (after running `npx cap add android`)
# 5. For iOS: download GoogleService-Info.plist and add it to the
#    ios/App/App Xcode target, plus upload your APNs auth key under
#    Project Settings → Cloud Messaging → Apple app configuration
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Real push notifications in the browser (Web Push / VAPID) ─
# Firebase only reaches the native app. These keys let the *website* and an
# installed PWA notify too - which is how most people use Udhaar.
#
#   npm run generate:vapid
#
# Set both values on the service. VAPID_PRIVATE_KEY is a secret; the public
# key is handed to browsers. Don't regenerate the pair once people have
# subscribed, or their subscriptions stop working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service can complain about your notifications (optional).
VAPID_SUBJECT=mailto:you@example.com
